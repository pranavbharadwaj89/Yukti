<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yukti.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A distributed tool shouldn't demand an exact 8.0.x runtime match —
         roll forward to whatever later major the user actually has
         installed, same as most real-world global tools do. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- .NET tool packaging: dotnet pack, then install from the local nupkg as a global tool. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yukti</ToolCommandName>
    <PackageId>Yukti.Cli</PackageId>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Self-contained single-file exe: a publish naming any RID above picks this up automatically
       via RuntimeIdentifier being set; a plain build or run with no RID is unaffected and stays a
       normal framework-dependent build. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yukti.Domain\Yukti.Domain.csproj" />
    <ProjectReference Include="..\Yukti.Contracts\Yukti.Contracts.csproj" />
    <ProjectReference Include="..\Yukti.Application\Yukti.Application.csproj" />
    <ProjectReference Include="..\Yukti.Orchestration\Yukti.Orchestration.csproj" />
    <ProjectReference Include="..\Yukti.Infrastructure.InMemory\Yukti.Infrastructure.InMemory.csproj" />
  </ItemGroup>

</Project>
