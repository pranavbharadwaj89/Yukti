<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yukti.Infrastructure</RootNamespace>
    <!-- The real, durable Infrastructure layer specified in Volume 1 Part V
         §32 — EF Core against CockroachDB (Postgres wire-protocol
         compatible, hence the Npgsql provider). Implements the exact same
         repository / IUnitOfWorkFactory interfaces as
         Yukti.Infrastructure.InMemory; Domain, Application, and
         Orchestration require zero changes (Volume 1 README's own stated
         plan, confirmed in INIT-YUKTI-BACKEND-001's Assumption A-02). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- YuktiDbContextFactory (design-time only) needs these to read
         ConnectionStrings:Yukti independent of any host's runtime config. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yukti.Domain\Yukti.Domain.csproj" />
    <ProjectReference Include="..\Yukti.Application\Yukti.Application.csproj" />
    <!-- D5-T1: OpenAiProvider reports through OrchestrationTelemetry's existing
         ai.request.duration/ai.request.timeout meters (FR-OBS-02) instead of a
         second, parallel set — Orchestration has no reference back to
         Infrastructure, so this is a one-way addition, not a cycle. -->
    <ProjectReference Include="..\Yukti.Orchestration\Yukti.Orchestration.csproj" />
  </ItemGroup>

</Project>
