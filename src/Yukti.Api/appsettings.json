{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Deployment": {
    "SelfHosted": true
  },

  "Outbound": {
    "Mode": "Restricted"
  },

  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  },

  "Ai": {
    "MaxValidationRetries": 1,
    "Capabilities": {
      "Analyst": { "MaxInputChars": 16000, "MaxOutputTokens": 1024, "Temperature": 0 },
      "Coder": { "MaxInputChars": 32000, "MaxOutputTokens": 2048, "Temperature": 0 }
    },
    "Pricing": {
      "gemini": { "InputPer1M": 0.10, "OutputPer1M": 0.40 }
    },
    "Budget": {
      "WeeklyCapUsd": 30.00,
      "WarnThreshold": 0.8,
      "DailyRequestQuota": 20
    }
  }
}
