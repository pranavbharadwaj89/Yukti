{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Deployment": {
    "SelfHosted": true
  },

  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  },

  "Ai": {
    "MaxValidationRetries": 1,
    "Capabilities": {
      "Analyst": { "MaxInputChars": 8500, "MaxOutputTokens": 1024, "Temperature": 0 },
      "Coder": { "MaxInputChars": 12000, "MaxOutputTokens": 2048, "Temperature": 0 }
    }
  }
}
