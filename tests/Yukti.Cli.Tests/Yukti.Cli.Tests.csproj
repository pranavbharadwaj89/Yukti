<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Yukti.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- API-T10: ApiImportTests calls OpenApiImporter/PostmanImporter directly — a pure
         transformation, unlike CliIntegrationTests' own deliberate process-spawning tests of the
         actual built exe (OutputType=Exe doesn't prevent referencing it as a library assembly). -->
    <ProjectReference Include="..\..\src\Yukti.Cli\Yukti.Cli.csproj" />
  </ItemGroup>

</Project>
