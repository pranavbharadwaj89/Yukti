<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Yukti.Orchestration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed to reference WebApplication/WebApplicationBuilder directly
         when hosting FixtureApp in-process (D3-T1) — a ProjectReference to
         a Sdk.Web project doesn't propagate its implicit framework
         reference to this plain Sdk project on its own. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yukti.Domain\Yukti.Domain.csproj" />
    <ProjectReference Include="..\..\src\Yukti.Contracts\Yukti.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Yukti.Application\Yukti.Application.csproj" />
    <ProjectReference Include="..\..\src\Yukti.Orchestration\Yukti.Orchestration.csproj" />
    <ProjectReference Include="..\..\src\Yukti.Infrastructure.InMemory\Yukti.Infrastructure.InMemory.csproj" />
    <!-- Test-only: D6-T5's Web-module mutation check needs the real
         ConfiguredOutboundGuard, not just the IOutboundGuard interface
         Yukti.Application already exposes. -->
    <ProjectReference Include="..\..\src\Yukti.Infrastructure\Yukti.Infrastructure.csproj" />
    <ProjectReference Include="..\..\demo\fixtures\FixtureApp\FixtureApp.csproj" />
  </ItemGroup>

</Project>
